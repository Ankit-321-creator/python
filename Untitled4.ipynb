    "num = int(input(\"enter the number\"))\n",
    "if num%2!=0:\n",
    "    print(\"weired\")\n",
    "elif  num%2==0 and 2<=num>=5:\n",
    "   print(\"not weired\")\n",
    "elif  num%2==0 and 6<=num<=20:\n",
    "   print(\"wired\")\n",
    "else:\n",
    "    num%2==0 and num>20\n",
    "    print(\"weired\")"
   ]
